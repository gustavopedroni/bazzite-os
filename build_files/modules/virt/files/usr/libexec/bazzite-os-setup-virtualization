#!/usr/bin/bash
# Chamado no login pelo /etc/xdg/autostart/bazzite-os-setup-virtualization.desktop.
# Nao da para rodar no build: a receita recusa root e usa sudo, flatpak --system e
# rpm-ostree kargs, que pedem a senha de quem esta logado. Entao ela abre num
# Konsole no primeiro login. Se falhar ou a janela fechar antes do fim, nao grava
# o stamp e tenta de novo no proximo login.
stamp="${XDG_STATE_HOME:-$HOME/.local/state}/bazzite-os/virtualization"
[[ -e "$stamp" ]] && exit 0
# Sem sudo a receita falharia a cada login.
id -nG | grep -qw wheel || exit 0
exec konsole --hold -e bash -c 'ujust setup-virtualization virt-on && mkdir -p "${1%/*}" && touch "$1"' _ "$stamp"
