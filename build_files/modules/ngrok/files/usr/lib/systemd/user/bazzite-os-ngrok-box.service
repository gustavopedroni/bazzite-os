# Habilitado em ngrok/setup.sh. O box e o authtoken (~/.config/ngrok) sao por
# usuario, entao isto e unit de usuario e nao de sistema.
[Unit]
Description=Cria o distrobox do ngrok (repo apt oficial)
# Roda ate o export existir; depois disso, nunca mais. Apagou o box e quer de
# volta? rm ~/.local/bin/ngrok e relogue (ou systemctl --user start).
ConditionPathExists=!%h/.local/bin/ngrok

[Service]
Type=oneshot
# --replace: sem o export, um box existente e resto de tentativa que morreu no
# meio (o `podman system migrate` do bazzite-portal no login para todos os
# containers). Sem isso o retry so diz "already exists" e nunca exporta.
ExecStart=/usr/bin/distrobox assemble create --replace --file /usr/share/bazzite-os/distrobox/ngrok.ini
# Sem rede no login: tenta de novo.
Restart=on-failure
RestartSec=1min

[Install]
WantedBy=default.target
