# Instalados por `flatpak preinstall` (ver flatpak-preinstall(5)), no escopo do
# sistema: na live ISO (build-disk.yml gera a lista do installer a partir
# deste arquivo), e no boot por bazzite-os-flatpak-preinstall.service.
# Desinstalou? Nao volta. App novo aqui entra no proximo boot. App tirado daqui
# e DESINSTALADO no proximo boot (o preinstall sincroniza nos dois sentidos).
# Branch=stable e obrigatorio: sem ele o flatpak procura "master", que o
# Flathub nao tem.
[Flatpak Preinstall com.spotify.Client]
Branch=stable

[Flatpak Preinstall com.slack.Slack]
Branch=stable

[Flatpak Preinstall com.getpostman.Postman]
Branch=stable

[Flatpak Preinstall com.getmailspring.Mailspring]
Branch=stable

[Flatpak Preinstall com.discordapp.Discord]
Branch=stable

[Flatpak Preinstall com.google.Chrome]
Branch=stable

[Flatpak Preinstall io.github.ilya_zlobintsev.LACT]
Branch=stable

[Flatpak Preinstall com.github.tchx84.Flatseal]
Branch=stable

[Flatpak Preinstall io.github.alainm23.planify]
Branch=stable

[Flatpak Preinstall io.dbeaver.DBeaverCommunity]
Branch=stable

[Flatpak Preinstall org.libreoffice.LibreOffice]
Branch=stable

[Flatpak Preinstall it.mijorus.gearlever]
Branch=stable

[Flatpak Preinstall org.videolan.VLC]
Branch=stable

[Flatpak Preinstall com.vysp3r.ProtonPlus]
Branch=stable

# MangoJuice: GUI do MangoHud, so existe no Flathub. Edita
# ~/.config/MangoHud/MangoHud.conf, lido pelo terra-mangohud (64+32 bit) que a
# base ja traz para Steam/Lutris nativos.
[Flatpak Preinstall io.github.radiolamp.mangojuice]
Branch=stable
