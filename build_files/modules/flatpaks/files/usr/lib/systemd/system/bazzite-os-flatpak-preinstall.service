# Habilitado em flatpaks/setup.sh. A live ISO ja embute esses flatpaks e o
# install-flatpaks.ks copia pro disco; este servico cobre o resto: rebase de
# outra imagem e app novo no .preinstall.
[Unit]
Description=Instala os flatpaks de /usr/share/flatpak/preinstall.d
Documentation=man:flatpak-preinstall(1)
Wants=network-online.target
# bazzite-flatpak-manager garante o remote flathub ligado.
After=network-online.target bazzite-flatpak-manager.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak preinstall -y
# Sem rede no boot: tenta de novo.
Restart=on-failure
RestartSec=1min

[Install]
WantedBy=multi-user.target
