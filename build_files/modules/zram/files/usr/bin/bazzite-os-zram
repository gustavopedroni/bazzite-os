#!/usr/bin/bash
# Uso: bazzite-os-zram [on|off|status]   (sem argumento: alterna)
# A config fica em /usr/lib; o que liga/desliga e o link de mesmo nome em /etc:
#   on  -> /etc/<arquivo> aponta para /usr/lib/<arquivo>
#   off -> /etc/<arquivo> aponta para /dev/null (mascara): padrao do Bazzite
# O link em /etc (e nao so o arquivo em /usr/lib) e por causa do tuned: ao
# aplicar um perfil ele reaplica /etc/sysctl.d, mas nao /usr/lib/sysctl.d. Sem
# o link, o perfil de desempenho trocaria swappiness para 10 e dirty para 40%.
# Mudanca local em /etc sobrevive a reboot e a update da imagem.
set -euo pipefail

NAME=99-bazzite-os-zram.conf
FILES=("systemd/zram-generator.conf.d/$NAME" "sysctl.d/$NAME")

is_off() { [[ $(readlink "/etc/${FILES[1]}") == /dev/null ]]; }

status() {
    if is_off; then echo "Tuning: DESLIGADO (padrao do Bazzite)"; else echo "Tuning: LIGADO"; fi
    zramctl
    sysctl vm.swappiness vm.page-cluster vm.watermark_scale_factor vm.watermark_boost_factor vm.dirty_bytes vm.dirty_background_bytes
}

# O tuned guarda o valor de cada sysctl que o perfil muda e o devolve ao sair
# do perfil. Pausar antes da troca e retomar depois faz ele guardar os valores
# novos, e o perfil ativo (ex.: desempenho) e reaplicado por cima.
tuned() {
    systemctl is-active -q tuned || return 0
    busctl call com.redhat.tuned /Tuned com.redhat.tuned.control "$1" >/dev/null || true
}

case "${1:-toggle}" in
    status) status; exit ;;
    toggle) if is_off; then set -- on; else set -- off; fi ;;
    on | off) ;;
    *) echo "Uso: $0 [on|off|status]"; exit 1 ;;
esac

[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"

tuned stop
trap 'tuned start' EXIT # retoma o tuned mesmo se algo abaixo falhar
for f in "${FILES[@]}"; do
    if [[ $1 == on ]]; then target=/usr/lib/$f; else target=/dev/null; fi
    mkdir -p "$(dirname "/etc/$f")"
    ln -sfn "$target" "/etc/$f"
done
if [[ $1 == off ]]; then
    # O sysctl --system nao desfaz valor que nenhum arquivo define mais: volta
    # aos padroes do kernel do Bazzite (OGC, iguais aos do upstream) antes de
    # reaplicar os arquivos do Bazzite.
    sysctl -q -w vm.swappiness=60 vm.page-cluster=3 vm.watermark_scale_factor=10 vm.watermark_boost_factor=15000 \
        vm.dirty_ratio=20 vm.dirty_background_ratio=10
fi
sysctl -q --system
tuned start
trap - EXIT

systemctl daemon-reload
# O restart faz swapoff, que precisa trazer o que esta no zram de volta para a
# RAM. Se nao couber, a config nova vale no proximo boot.
systemctl restart systemd-zram-setup@zram0 ||
    echo "zram em uso: tamanho novo vale no proximo boot"
status
